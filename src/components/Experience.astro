---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/experience';
---

<section class="section container" aria-labelledby="work">
  <SectionHeading index="02" title="Experience" id="work" />

  <ol class="timeline" data-timeline>
    <span class="timeline__progress" data-timeline-progress aria-hidden="true"></span>
    {
      experience.map((role) => (
        <li class="timeline__item" data-reveal>
          <span class="timeline__dot" aria-hidden="true" />
          <div class="timeline__body">
            <div class="timeline__head">
              <h3 class="timeline__company">{role.company}</h3>
              <span class="timeline__period">{role.period}</span>
            </div>
            <p class="timeline__role">
              {role.title} <span class="timeline__loc">· {role.location}</span>
            </p>
            {role.groups?.map((g) => (
              <div class="timeline__group">
                <p class="timeline__client">
                  {g.client}
                  {g.note && <span class="timeline__client-note"> · {g.note}</span>}
                </p>
                <ul class="timeline__bullets">
                  {g.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </div>
            ))}
            {role.bullets && (
              <ul class="timeline__bullets">
                {role.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
            <ul class="chips timeline__chips">
              {role.stack.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }
  /* Amber progress line drawn on scroll (GSAP), over the dim item track. */
  .timeline__progress {
    position: absolute;
    left: 0;
    top: 0.35rem;
    bottom: 3rem;
    width: 1px;
    background: linear-gradient(var(--accent), var(--accent-strong));
    transform-origin: top;
    z-index: 1;
  }
  .timeline__item {
    position: relative;
    padding: 0 0 3rem 2.25rem;
    border-left: 1px solid var(--border);
  }
  .timeline__item:last-child {
    padding-bottom: 0;
    border-left-color: transparent;
  }
  .timeline__dot {
    position: absolute;
    left: -5px;
    top: 0.35rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg), 0 0 14px 0 var(--accent);
  }
  .timeline__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  .timeline__company {
    font-size: var(--step-1);
  }
  .timeline__period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    letter-spacing: 0.03em;
  }
  .timeline__role {
    color: var(--text);
    font-weight: 500;
    margin: 0.35rem 0 1rem;
  }
  .timeline__loc {
    color: var(--text-muted);
    font-weight: 400;
  }
  /* Client sub-group within a role */
  .timeline__group {
    margin-bottom: 1.4rem;
  }
  .timeline__client {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--accent);
  }
  .timeline__client-note {
    color: var(--text-muted);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .timeline__bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 1.1rem;
    display: grid;
    gap: 0.6rem;
  }
  .timeline__bullets li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .timeline__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 1px;
    background: var(--accent);
  }

  @media (max-width: 620px) {
    .timeline__period {
      order: 3;
    }
  }
</style>
