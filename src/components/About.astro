---
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';
---

<section class="section container" aria-labelledby="about">
  <SectionHeading index="01" title="About" id="about" />

  <div class="about">
    <div class="about__text" data-reveal>
      {site.bio.map((para) => <p>{para}</p>)}

      <dl class="about__langs" aria-label="Languages">
        {
          site.languages.map((lang) => (
            <div class="about__lang">
              <dt>{lang.name}</dt>
              <dd>{lang.level}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="about__portrait" data-reveal>
      <img
        src="/portrait.jpg"
        width="900"
        height="900"
        loading="lazy"
        decoding="async"
        alt="Sami Masmoudi at his desk"
      />
      <span class="about__portrait-tint" aria-hidden="true"></span>
    </figure>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .about__text p {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text);
    margin-bottom: 1.25rem;
  }
  .about__text p:not(:first-child) {
    font-size: var(--step-0);
    color: var(--text-muted);
  }

  .about__langs {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }
  .about__lang dt {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
  }
  .about__lang dd {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-top: 0.15rem;
  }

  .about__portrait {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    aspect-ratio: 1;
    max-width: 420px;
    justify-self: end;
    width: 100%;
  }
  .about__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Duotone base: desaturate + lift contrast */
    filter: grayscale(1) contrast(1.08) brightness(0.92);
    transition: filter 0.5s ease;
  }
  .about__portrait-tint {
    position: absolute;
    inset: 0;
    background: var(--accent);
    mix-blend-mode: color;
    opacity: 0.55;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .about__portrait:hover img {
    filter: grayscale(0.15) contrast(1.02) brightness(1);
  }
  .about__portrait:hover .about__portrait-tint {
    opacity: 0;
  }

  @media (max-width: 820px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about__portrait {
      order: -1;
      justify-self: start;
      max-width: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about__portrait img,
    .about__portrait-tint {
      transition: none;
    }
  }
</style>
