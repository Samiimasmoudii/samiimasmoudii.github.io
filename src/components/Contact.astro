---
import SectionHeading from './SectionHeading.astro';
import { site } from '../data/site';
---

<section class="section container" aria-labelledby="contact">
  <SectionHeading index="06" title="Contact" id="contact" />

  <div class="contact" data-reveal>
    <p class="contact__lead">
      Let’s build something.<br />
      I’m always up for a good problem — say hello.
    </p>

    <div class="contact__actions">
      <a class="btn" href={`mailto:${site.email}`}>Email me</a>
      <a class="btn btn--ghost" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="btn btn--ghost" href={site.github} target="_blank" rel="noopener">GitHub</a>
      <a class="btn btn--ghost" href={site.cvPath} download>Download CV</a>
    </div>

  
  </div>
</section>

<style>
  .contact {
    max-width: 40ch;
  }
  .contact__lead {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 2.25rem;
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .contact__email a {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .contact__email a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
