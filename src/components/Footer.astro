---
import { site } from '../data/site';
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__copy">© 2026 {site.name}</p>
    <p class="footer__credit">Built with Astro + three.js</p>
    <a class="footer__top" href="#top">Back to top ↑</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 2.5rem;
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .footer__credit {
    color: var(--text-muted);
    opacity: 0.75;
  }
  .footer__top {
    transition: color 0.2s ease;
  }
  .footer__top:hover {
    color: var(--accent);
  }
</style>
