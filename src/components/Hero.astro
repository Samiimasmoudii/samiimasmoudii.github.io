---
import { site } from '../data/site';

// Build the name as tight per-letter spans (no whitespace between them, so
// the inline-block letters don't render gaps) for a staggered kinetic reveal.
let letterIndex = 0;
const nameHtml = site.name
  .split(' ')
  .map((word) => {
    const letters = word
      .split('')
      .map(
        (ch) =>
          `<span class="hero__letter" aria-hidden="true" style="--i:${letterIndex++}">${ch}</span>`,
      )
      .join('');
    return `<span class="hero__word">${letters}</span>`;
  })
  .join('<span class="hero__space" aria-hidden="true"></span>');
---

<section class="hero" id="top">
  <div class="hero__bg" aria-hidden="true"></div>
  <canvas class="hero__canvas" id="hero-canvas" aria-hidden="true"></canvas>

  <div class="hero__content container">
    <p class="eyebrow hero__eyebrow">{site.title}</p>

    <h1 class="hero__name" aria-label={site.name} set:html={nameHtml}></h1>

    <p class="hero__tagline">{site.tagline}</p>

    <div class="hero__actions">
      <a class="btn" href="#work" data-magnetic>View work</a>
      <a class="btn btn--ghost" href={site.cvPath} download>Download CV</a>
    </div>
  </div>

  <a class="hero__scroll" href="#about" aria-label="Scroll to about">
    <span>Scroll</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  /* Fallback / ambience behind the canvas */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(60% 50% at 72% 38%, var(--accent-soft), transparent 70%),
      radial-gradient(45% 40% at 20% 80%, rgba(255, 158, 27, 0.08), transparent 70%),
      var(--bg);
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .hero__canvas.is-ready {
    opacity: 1;
  }

  .hero__content {
    width: min(var(--content-width), 100% - 2 * var(--gutter));
    padding-block: 6rem 4rem;
  }
  .hero__eyebrow {
    margin-bottom: 1.4rem;
  }
  .hero__name {
    font-size: var(--step-4);
    line-height: 0.92;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }
  /* NOTE: .hero__word / .hero__letter / .hero__space are styled in global.css
     because the name is injected via set:html and Astro's scoped styles would
     not apply to injected markup. */

  .hero__tagline {
    max-width: 42ch;
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.4;
    margin-bottom: 2.5rem;
    animation: fade-up 0.9s ease 0.6s backwards;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    animation: fade-up 0.9s ease 0.75s backwards;
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.75rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .hero__scroll-line {
    width: 1px;
    height: 42px;
    background: linear-gradient(var(--accent), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes scroll-pulse {
    0%,
    100% {
      transform: scaleY(0.4);
      opacity: 0.4;
    }
    50% {
      transform: scaleY(1);
      opacity: 1;
    }
  }

  @media (max-width: 759px) {
    .hero__scroll {
      display: none;
    }
    .hero__content {
      padding-block: 7rem 5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__tagline,
    .hero__actions {
      animation: none;
    }
    .hero__scroll-line {
      animation: none;
      opacity: 0.6;
    }
  }
</style>

<script>
  // Lazy-load three.js (a large dependency) on idle so it never blocks first
  // paint or interactivity. The CSS gradient fallback shows until it mounts.
  const canvas = document.getElementById('hero-canvas');
  if (canvas instanceof HTMLCanvasElement) {
    const start = () =>
      import('../scripts/pointcloud').then(({ initPointCloud }) => {
        const cleanup = initPointCloud(canvas);
        window.addEventListener('beforeunload', cleanup, { once: true });
      });
    if ('requestIdleCallback' in window) {
      requestIdleCallback(start, { timeout: 2000 });
    } else {
      window.addEventListener('load', start);
    }
  }
</script>
