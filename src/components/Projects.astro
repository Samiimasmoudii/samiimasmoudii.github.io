---
import SectionHeading from './SectionHeading.astro';
import { projects } from '../data/projects';
---

<section class="section container" aria-labelledby="projects">
  <SectionHeading index="03" title="Projects" id="projects" />

  <div class="projects">
    {
      projects.map((p) => (
        <article class="pcard" data-reveal>
          <div class="pcard__top">
            <h3 class="pcard__name">{p.name}</h3>
            <span class="pcard__period">{p.period}</span>
          </div>
          <p class="pcard__summary">{p.summary}</p>
          <ul class="chips pcard__chips">
            {p.tech.map((t) => (
              <li class="chip">{t}</li>
            ))}
          </ul>
          {p.link && (
            <a class="pcard__link" href={p.link} target="_blank" rel="noopener">
              View project →
            </a>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }
  .pcard {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.6rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: transform 0.3s ease, border-color 0.3s ease, background-color 0.3s ease;
  }
  .pcard:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    background: var(--surface-2);
  }
  .pcard__top {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .pcard__name {
    font-size: 1.2rem;
    line-height: 1.15;
  }
  .pcard__period {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.03em;
  }
  .pcard__summary {
    color: var(--text-muted);
    line-height: 1.55;
    font-size: 0.96rem;
    flex: 1;
  }
  .pcard__chips {
    margin-top: auto;
  }
  .pcard__link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
</style>
